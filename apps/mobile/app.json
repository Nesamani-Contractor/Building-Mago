{
  "expo": {
    "name": "Mago",
    "slug": "mago",
    "scheme": "mago",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mago.ios",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.mago.android",
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false,
            "default": "development"
          }
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Mago uses your front camera only for optional before and after photos. Your photos stay on your phone.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "mode": "demo"
    }
  }
}